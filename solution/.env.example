# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key — get one at https://console.anthropic.com
# Used server-side only; never sent to the client.
ANTHROPIC_API_KEY=your-api-key-here

# Your Neon pooled Postgres connection string.
# Example: postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Model ─────────────────────────────────────────────────────────────────────

# Which Claude model to use for all chat requests.
# Options: claude-sonnet-4-6 | claude-haiku-4-5-20251001
# Sonnet produces better artifact HTML and citations; Haiku is ~10x cheaper/faster.
DEFAULT_MODEL=claude-sonnet-4-6

# Allow users to switch models in the UI mid-conversation.
# true  → toggle visible in header (recommended for local dev and reviewer demos)
# false → header shows read-only model badge; DEFAULT_MODEL is always used
MODEL_SWITCHING_ALLOWED=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Default: 10 requests per 60-minute rolling window per client.
# Each request expires individually — it's not a fixed hourly bucket.
# See docs/CONFIGURATION.md for common configurations.

# Maximum chat requests per client per window.
RATE_LIMIT_REQUESTS=10

# Rolling window duration in minutes.
RATE_LIMIT_WINDOW_MINUTES=60
